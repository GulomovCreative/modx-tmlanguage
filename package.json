{
  "name": "modx-tmlanguage",
  "version": "1.2.0",
  "description": "TextMate grammar files for MODX Revolution syntax for VS Code, Sublime Text, and Atom",
  "author": {
    "name": "Gulomov Bakhtovar",
    "email": "gulomovcreative@gmail.com"
  },
  "main": "index.js",
  "exports": {
    ".": "./modx.tmLanguage.json"
  },
  "files": [
    "modx.tmLanguage.json",
    "index.js"
  ],
  "scripts": {
    "test": "node --test test/grammar.test.js",
    "test:update": "node test/snapshot.js",
    "prepublishOnly": "npm test",
    "publish:major": "npm version major",
    "publish:minor": "npm version minor",
    "publish:patch": "npm version patch",
    "postversion": "git push && git push --tags && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GulomovCreative/modx-tmlanguage.git"
  },
  "keywords": [
    "modx",
    "MODX",
    "TextMate",
    "syntax"
  ],
  "license": "MIT",
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
