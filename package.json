{
  "name": "modx-tmlanguage",
  "version": "1.2.0",
  "description": "TextMate grammar files for MODX Revolution syntax for VS Code, Sublime Text, and Atom",
  "author": {
    "name": "Gulomov Bakhtovar",
    "email": "gulomovcreative@gmail.com"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./modx.tmLanguage.json": "./modx.tmLanguage.json",
    "./package.json": "./package.json"
  },
  "files": [
    "modx.tmLanguage.json",
    "index.js"
  ],
  "scripts": {
    "test": "node --test test/grammar.test.js test/package.test.js test/release.test.js test/embedded.test.js",
    "test:update": "node test/snapshot.js",
    "prepublishOnly": "npm test",
    "preversion": "node scripts/preversion.js",
    "version": "node scripts/version.js",
    "publish:major": "npm version major",
    "publish:minor": "npm version minor",
    "publish:patch": "npm version patch",
    "postversion": "git push origin master && git push origin --tags && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GulomovCreative/modx-tmlanguage.git"
  },
  "bugs": {
    "url": "https://github.com/GulomovCreative/modx-tmlanguage/issues"
  },
  "homepage": "https://github.com/GulomovCreative/modx-tmlanguage#readme",
  "keywords": [
    "modx",
    "MODX",
    "TextMate",
    "syntax"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=12"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.4.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
