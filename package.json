{
  "name": "@gulomov/modx-tmlanguage",
  "version": "2.0.1",
  "description": "TextMate grammar for MODX Revolution tag syntax, for VS Code, Sublime Text and other editors that read TextMate grammars",
  "author": {
    "name": "Gulomov Bakhtovar",
    "email": "gulomovcreative@gmail.com"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./modx.tmLanguage.json": "./modx.tmLanguage.json",
    "./language-configuration.json": "./language-configuration.json",
    "./package.json": "./package.json"
  },
  "files": [
    "modx.tmLanguage.json",
    "language-configuration.json",
    "index.js"
  ],
  "scripts": {
    "test": "node --test test/grammar.test.js test/language-configuration.test.js test/package.test.js test/release.test.js test/embedded.test.js test/preview.test.js test/fuzz.test.js test/performance.test.js",
    "test:update": "node test/snapshot.js",
    "preview:update": "node scripts/theme-preview.js",
    "prepublishOnly": "npm test",
    "preversion": "node scripts/preversion.js",
    "version": "node scripts/version.js",
    "publish:major": "npm version major",
    "publish:minor": "npm version minor",
    "publish:patch": "npm version patch",
    "postversion": "git push origin master && git push origin --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GulomovCreative/modx-tmlanguage.git"
  },
  "bugs": {
    "url": "https://github.com/GulomovCreative/modx-tmlanguage/issues"
  },
  "homepage": "https://github.com/GulomovCreative/modx-tmlanguage#readme",
  "keywords": [
    "modx",
    "modx-revolution",
    "tmlanguage",
    "textmate",
    "grammar",
    "syntax-highlighting",
    "vscode",
    "sublime-text"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=12"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.4.3",
    "shiki": "^4.4.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
