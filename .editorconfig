root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Fixtures are samples of real templates: their whitespace is significant,
# trailing whitespace included, and editing it changes the snapshots.
[test/fixtures/**]
trim_trailing_whitespace = false

[test/snapshots/**]
trim_trailing_whitespace = false
