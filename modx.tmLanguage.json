{
  "name": "modx",
  "scopeName": "text.html.modx",
  "fileTypes": [
    "tpl",
    "html"
  ],
  "injections": {
    "L:text.html.modx - comment.block.modx": {
      "patterns": [
        {
          "include": "#interpolation"
        }
      ]
    }
  },
  "patterns": [
    {
      "include": "#interpolation"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "interpolation": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#main"
        },
        {
          "include": "#timing-tags"
        }
      ]
    },
    "main": {
      "name": "meta.tag.modx",
      "begin": "(\\[\\[)(!?)([\\x{0025}\\x{002a}\\x{007e}\\$]?\\+{0,2})([-_a-zA-Z0-9\\.]*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.modx"
        },
        "2": {
          "name": "keyword.control.uncached.modx"
        },
        "3": {
          "name": "support.type.modx"
        },
        "4": {
          "name": "entity.name.function.modx"
        }
      },
      "patterns": [
        {
          "include": "#propertyset"
        },
        {
          "include": "#modifier"
        },
        {
          "include": "#attribute"
        },
        {
          "include": "#value"
        },
        {
          "match": "\\?",
          "name": "punctuation.separator.properties.modx"
        },
        {
          "include": "#integer"
        }
      ],
      "end": "(\\]\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.modx"
        }
      }
    },
    "propertyset": {
      "patterns": [
        {
          "match": "(@)([-_a-zA-Z0-9\\.]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.propertyset.modx"
            },
            "2": {
              "name": "entity.name.type.propertyset.modx"
            }
          }
        }
      ]
    },
    "modifier": {
      "patterns": [
        {
          "match": "(:)([-_a-zA-Z0-9\\.]+)\\s*(\\=)?",
          "captures": {
            "1": {
              "name": "punctuation.separator.modifier.modx"
            },
            "2": {
              "name": "support.function.modifier.modx"
            },
            "3": {
              "name": "keyword.operator.assignment.modx"
            }
          }
        }
      ]
    },
    "attribute": {
      "patterns": [
        {
          "match": "(\\&)\\s*([-_a-zA-Z0-9\\.]+)\\s*(\\=)?",
          "captures": {
            "1": {
              "name": "punctuation.definition.parameter.modx"
            },
            "2": {
              "name": "variable.parameter.modx"
            },
            "3": {
              "name": "keyword.operator.assignment.modx"
            }
          }
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "name": "string.other.modx",
          "begin": "\\`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.modx"
            }
          },
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "include": "#integer"
            }
          ],
          "end": "\\`",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.modx"
            }
          }
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.modx",
          "begin": "\\[\\[\\-\\s?",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.modx"
            }
          },
          "patterns": [
            {
              "include": "#nested-tag"
            }
          ],
          "end": "\\]\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.modx"
            }
          }
        }
      ]
    },
    "nested-tag": {
      "patterns": [
        {
          "begin": "\\[\\[",
          "end": "\\]\\]",
          "patterns": [
            {
              "include": "#nested-tag"
            }
          ]
        }
      ]
    },
    "timing-tags": {
      "patterns": [
        {
          "name": "meta.tag.timing.modx",
          "begin": "(\\[\\^)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.modx"
            }
          },
          "contentName": "constant.other.timing.modx",
          "end": "(\\^\\])",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.modx"
            }
          }
        }
      ]
    },
    "integer": {
      "patterns": [
        {
          "name": "constant.numeric.modx",
          "match": "[+-]?\\b[0-9][0-9]*(?:\\.[0-9][0-9]*)?(?:[eE][+-]?[0-9]+)?\\b"
        }
      ]
    }
  }
}
